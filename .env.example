# Which LLM provider economy/llm.py uses: "gemini" (default, free) or "openai"
LLM_PROVIDER=gemini

# Required if LLM_PROVIDER=gemini. Free key, no card needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required if LLM_PROVIDER=openai. https://platform.openai.com/api-keys
OPENAI_API_KEY=
